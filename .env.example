# Copia este archivo como .env (desarrollo) o define estas variables en tu hosting.

# Dominio público del sitio (sitemap, canonical, hreflang, Open Graph)
NUXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Correo de contacto (opcional)
NUXT_PUBLIC_CONTACT_EMAIL=

# --- Medición (cada una se activa solo si tiene valor) ---

# Plausible: URL del script que aparece en el panel de Plausible
# (Site settings > General > Site installation). Ej.: https://plausible.io/js/pa-XXXXXXXX.js
NUXT_PUBLIC_PLAUSIBLE_SCRIPT=

# Google Analytics 4: ID de medición del flujo web. Ej.: G-ABC123DEF4
NUXT_PUBLIC_GA_ID=

# Meta Pixel: ID del conjunto de datos (píxel) en el Administrador de eventos. Ej.: 1234567890123456
NUXT_PUBLIC_META_PIXEL_ID=
